# Local Ollama endpoint (no cloud API keys are used anywhere in this app)
OLLAMA_BASE_URL=http://localhost:11434
# Default model. Switch between qwen2.5:3b (fast) and qwen2.5:7b (quality) on the Settings page,
# or set any installed tag here (qwen2.5:3b, qwen2.5:7b, qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.4
OLLAMA_TIMEOUT=300
MAX_INPUT_CHARS=60000
# Optional: custom SQLite location
# MCQ_DB_PATH=data/quizzes.db

# --- LLM Performance evaluation (all optional) ---
# The judge model is chosen per run (run_evaluation.bat uses the other model; or pass --judge <tag>).
# Judge endpoint (defaults to OLLAMA_BASE_URL). A non-local endpoint is refused unless EVAL_ALLOW_EXTERNAL_JUDGE=1.
# EVAL_JUDGE_BASE_URL=http://localhost:11434
# EVAL_ALLOW_EXTERNAL_JUDGE=0
# Pricing registry used for "Cost per Successful Task"
# EVAL_PRICING_FILE=evaluation/pricing.json
